rules_version = '2';
// Firestore security rules for ArachniGotchi online play.
// Paste into Firebase console -> Firestore Database -> Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // player profile: public name, only the owner can write it
    match /users/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) && request.resource.data.name is string
                   && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 20;
    }
    // full private save (JSON string): only the owner
    match /saves/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && request.resource.data.json is string && request.resource.data.json.size() < 500000;
    }
    // public spider summary for leaderboards and the gallery
    match /spiders/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) && request.resource.data.owner == uid;
    }
    // courtship requests between two players
    match /matings/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
                    && request.resource.data.to != request.auth.uid && request.resource.data.status == 'pending';
      allow update: if signedIn()
                    && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid)
                    && request.resource.data.from == resource.data.from && request.resource.data.to == resource.data.to
                    && request.resource.data.fromSpider == resource.data.fromSpider
                    // only the recipient may change the status (accept / decline)
                    && (request.resource.data.status == resource.data.status || request.auth.uid == resource.data.to);
    }
  }
}
